{
  "name": "Slack App-in-Tab",
  "description": "Open the Slack app with its multi-workspace sidebar in a simple browser tab",
  "version": "2.0",
  "manifest_version": 3,
  "icons": {
    "48": "slack-app-in-tab-logo-48x48.png",
    "128": "slack-app-in-tab-logo-128x128.png"
  },
  "content_scripts": [
    {
      "js": [
        "contentScript.js"
      ],
      "matches": [
        "https://*.slack.com/*"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "host_permissions": [
    "https://*.slack.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "slack-app-in-tab@lavaux.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
